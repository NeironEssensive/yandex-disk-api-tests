# Скопируйте этот файл в .env и подставьте свой токен:
#   cp .env.example .env
#
# Токен получается на полигоне https://yandex.ru/dev/disk/poligon/ ДЛЯ ТЕСТОВОГО аккаунта.
# Файл .env перечислен в .gitignore, поэтому токен не попадёт в репозиторий.

YANDEX_DISK_TOKEN=y0_AgAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Остальное менять не обязательно — значения по умолчанию лежат
# в src/test/resources/application.properties

# YANDEX_DISK_BASE_URI=https://cloud-api.yandex.net
# YANDEX_DISK_PLAYGROUND_ROOT=disk:/qa-autotests
# ASYNC_TIMEOUT_SECONDS=60
# ASYNC_POLL_INTERVAL_MS=1000
